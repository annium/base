<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AgileObjects.ReadableExpressions" Version="4.1.3" />
    <PackageVersion Include="Ben.Demystifier" Version="0.4.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing.XUnit" Version="1.1.2" />
    <!-- Held at the Roslyn version the SDK's compiler runs, and the one entry in this file that must not
         be bumped on its own. Annium.Analyzers is loaded by that compiler, and an analyzer built against a
         newer one is refused outright: 5.9.0 builds here, then every consuming project fails with CS9057
         ("references version 5.9.0.0 of the compiler, which is newer than 5.0.0.0"). Raise it only
         together with the SDK. `xs update` has no way to exclude a package, so it offers the bump every
         time - put it back.

         This is the only Microsoft.CodeAnalysis.* entry the pin belongs on: Annium.Analyzers is the sole
         project referencing any of them directly, and it references Workspaces. A sibling pin on
         Microsoft.CodeAnalysis.CSharp sat here carrying the same comment while no project asked for that
         package at all - inert under central package management, and misleading about where the ceiling
         actually applies. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Primitives" Version="10.0.11" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.22.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15" />
    <PackageVersion Include="Namotion.Reflection" Version="3.5.1" />
    <PackageVersion Include="NodaTime" Version="3.3.3" />
    <PackageVersion Include="OneOf" Version="3.0.271" />
    <PackageVersion Include="Scriban" Version="7.2.6" />
    <PackageVersion Include="SimpleBase" Version="5.6.4" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
